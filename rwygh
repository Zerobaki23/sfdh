local function checkForRareDrop(unknowns)
    if not unknowns or #unknowns == 0 then return false end
    for _, entry in ipairs(unknowns) do
        local lower = entry:lower()
        if lower:find("serum") or lower:find("mythic") then
            return true
        end
    end
    return false
end

local function sendWebhook(gold, xp, canes, unknowns)
    if not requestFunction then
        warn("No request function found!")
        return
    end

    local shouldPing = checkForRareDrop(unknowns)

    local description = string.format(
        "Gold: %s\nXP: %s\nCanes: %s",
        stripEmojis(tostring(gold or "?")),
        stripEmojis(tostring(xp or "?")),
        stripEmojis(tostring(canes or "?"))
    )

    if unknowns and #unknowns > 0 then
        local cleanUnknowns = {}
        for _, entry in ipairs(unknowns) do
            table.insert(cleanUnknowns, stripEmojis(entry))
        end
        description = description .. "\n\nOthers:\n" .. table.concat(cleanUnknowns, "\n")
    end

    if shouldPing then
        description = description .. "\n\nRARE DROP DETECTED!"
    end

    local payload = {
        username = "MY USERNAME",
        content = shouldPing and ("<@" .. PING_USER_ID .. "> Rare drop detected!") or nil,
        embeds = {
            {
                title = "Rewards Update",
                description = description,
                color = shouldPing and 15158332 or 16766720,
            }
        }
    }

    local ok, encoded = pcall(HttpService.JSONEncode, HttpService, payload)
    if not ok then
        warn("JSON encode failed:", encoded)
        return
    end

    local ok2, response = pcall(requestFunction, {
        Url = webhookUrl,
        Method = "POST",
        Headers = { ["Content-Type"] = "application/json" },
        Body = encoded
    })

    if not ok2 then
        warn("Request failed:", response)
        return
    end

    print("Status:", response.StatusCode)
    print("Body:", response.Body)
    task.wait(1)
end

local player = Players.LocalPlayer

local iconLabels = {
    ["rbxassetid://15296242924"] = "EXP",
    ["rbxassetid://15147178963"] = "Gold",
    ["rbxassetid://138197199153705"] = "Canes",
}

local lastSnapshot = ""

local function waitForGui()
    print("Waiting for GUI...")

    local gui = player:WaitForChild("PlayerGui")

    local interface
    repeat
        interface = gui:FindFirstChild("Interface")
        if not interface then task.wait(0.5) end
    until interface

    local rewards
    repeat
        rewards = interface:FindFirstChild("Rewards")
        if not rewards then task.wait(0.5) end
    until rewards

    local main1
    repeat
        main1 = rewards:FindFirstChild("Main")
        if not main1 then task.wait(0.5) end
    until main1

    local info
    repeat
        info = main1:FindFirstChild("Info")
        if not info then task.wait(0.5) end
    until info

    local main2
    repeat
        main2 = info:FindFirstChild("Main")
        if not main2 then task.wait(0.5) end
    until main2

    local items
    repeat
        items = main2:FindFirstChild("Items")
        if not items then task.wait(0.5) end
    until items

    repeat
        local hasSlot = false
        for _, child in ipairs(items:GetChildren()) do
            if child:IsA("Frame") then
                hasSlot = true
                break
            end
        end
        if not hasSlot then
            print("Waiting for item slots to populate...")
            task.wait(0.5)
        else
            break
        end
    until false

    print("GUI fully loaded!")
    return items
end

local function getRewards(items)
    local gold, xp, canes = "?", "?", "?"
    local unknowns = {}

    for _, slot in ipairs(items:GetChildren()) do
        if slot:IsA("Frame") then
            local main = slot:FindFirstChild("Main")
            if main then
                local inner = main:FindFirstChild("Inner")
                if inner then
                    local quantityLabel = inner:FindFirstChild("Quantity")
                    local icon = inner:FindFirstChild("Icon")

                    local quantity = quantityLabel and quantityLabel.Text or "?"
                    local iconId = icon and icon.Image or "?"

                    print("Slot:", slot.Name, "| Icon:", iconId, "| Qty:", quantity)

                    local label = iconLabels[iconId]

                    if not label then
                        local assetId = iconId:match("rbxassetid://(%d+)") or iconId:match("id=(%d+)") or iconId
                        label = "Unknown (ID: " .. assetId .. ")"

                        local ok, response = pcall(requestFunction, {
                            Url = "https://economy.roblox.com/v2/assets/" .. assetId .. "/details",
                            Method = "GET",
                            Headers = { ["Content-Type"] = "application/json" }
                        })
                        if ok and response and response.StatusCode == 200 then
                            local ok2, data = pcall(HttpService.JSONDecode, HttpService, response.Body)
                            if ok2 and data and data.Name then
                                label = stripEmojis(data.Name) .. " (ID: " .. assetId .. ")"
                                iconLabels[iconId] = label
                            end
                        end
                    end

                    if label == "Gold" then
                        gold = quantity
                    elseif label == "EXP" then
                        xp = quantity
                    elseif label == "Canes" then
                        canes = quantity
                    else
                        table.insert(unknowns, stripEmojis(label) .. " | Qty: " .. quantity)
                    end
                else
                    print("No Inner found in slot:", slot.Name)
                end
            else
                print("No Main found in slot:", slot.Name)
            end
        end
    end

    return gold, xp, canes, unknowns
end

setupTeleportQueue()

local items = waitForGui()

print("Starting rewards tracker...")

while true do
    local ok, gold, xp, canes, unknowns = pcall(getRewards, items)

    if ok then
        local snapshot = string.format("Gold:%s|XP:%s|Canes:%s", gold, xp, canes)
        if unknowns then
            snapshot = snapshot .. "|" .. table.concat(unknowns, "|")
        end

        if snapshot ~= lastSnapshot then
            lastSnapshot = snapshot
            print("Sending update...")
            sendWebhook(gold, xp, canes, unknowns)
        else
            print("No change detected.")
        end
    else
        warn("getRewards error:", gold)
    end

    task.wait(5)
end
