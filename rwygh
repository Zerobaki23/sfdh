-- =============================================
--   HELPERS
-- =============================================
local function stripEmojis(str)
    return tostring(str):gsub("[^\32-\126]", "")
end

local function setupTeleportQueue()
    if syn and syn.queue_on_teleport then
        syn.queue_on_teleport([[]])
    elseif queue_on_teleport then
        queue_on_teleport([[]])
    end
end

-- Parses Roblox UI numbers: "405,221" / "1.2M" / "5K" / "123" → integer
local function parseRobloxNumber(str)
    if not str then return 0 end
    local s = tostring(str):gsub("%s+", "")

    -- Handle K / M / B / T suffixes
    local suffixes = { K = 1e3, M = 1e6, B = 1e9, T = 1e12 }
    local num, suffix = s:match("^([%d%.]+)([KkMmBbTt])$")
    if num and suffix then
        local mult = suffixes[suffix:upper()]
        return math.floor((tonumber(num) or 0) * mult)
    end

    -- Plain number, strip commas and any stray non-digit chars
    local cleaned = s:gsub(",", ""):gsub("[^%d]", "")
    if cleaned == "" then return 0 end
    return tonumber(cleaned) or 0
end

-- =============================================
--   SEND SERUM TO FLASK
-- =============================================
local function sendToFlask(count)
    if not requestFunction then return end

    local ok, encoded = pcall(HttpService.JSONEncode, HttpService, { count = count })
    if not ok then return end

    local success, response = pcall(requestFunction, {
        Url    = FLASK_SERVER_URL,
        Method = "POST",
        Headers = { ["Content-Type"] = "application/json" },
        Body   = encoded
    })

    if success then
        print("[Serum Counter] Sent count to Flask: +" .. count)
    else
        warn("[Serum Counter] Failed to reach Flask server: " .. tostring(response))
    end
end

-- =============================================
--   SEND GOLD TO FLASK
-- =============================================
local function sendGoldToFlask(amount)
    if not requestFunction then return end

    -- Debug: print raw value so you can see exactly what the UI gives us
    print("[Gold Tracker] Raw UI value: " .. tostring(amount))

    local numAmount = parseRobloxNumber(amount)
    if numAmount <= 0 then
        warn("[Gold Tracker] Skipping non-positive gold value: " .. tostring(amount))
        return
    end

    local ok, encoded = pcall(HttpService.JSONEncode, HttpService, { amount = numAmount })
    if not ok then return end

    local success, response = pcall(requestFunction, {
        Url    = FLASK_GOLD_URL,
        Method = "POST",
        Headers = { ["Content-Type"] = "application/json" },
        Body   = encoded
    })

    if success then
        print("[Gold Tracker] Sent gold to Flask: +" .. numAmount)
    else
        warn("[Gold Tracker] Failed to reach Flask server: " .. tostring(response))
    end
end

-- =============================================
--   DISCORD WEBHOOK
-- =============================================
local function checkForRareDrop(unknowns)
    if not unknowns or #unknowns == 0 then return false end
    for _, entry in ipairs(unknowns) do
        local lower = tostring(entry):lower()
        if lower:find("colossal serum") or lower:find("serum") then
            return true
        end
    end
    return false
end

local function sendWebhook(gold, xp, canes, unknowns)
    if not requestFunction then return end

    local shouldPing = checkForRareDrop(unknowns)

    local PLACE_ID    = tostring(game.PlaceId)
    local UNIVERSE_ID = tostring(game.GameId)
    local gameIconUrl = "https://www.roblox.com/asset-thumbnail/image?assetId=" .. PLACE_ID .. "&width=150&height=150&format=png"
    local gameLink    = "https://www.roblox.com/games/" .. PLACE_ID

    local descLines = {
        "```",
        string.format("%-8s %s", "GOLD",  stripEmojis(gold)),
        string.format("%-8s %s", "XP",    stripEmojis(xp)),
        string.format("%-8s %s", "CANES", stripEmojis(canes)),
        "```",
    }

    if unknowns and #unknowns > 0 then
        descLines[#descLines + 1] = "**Others**"
        descLines[#descLines + 1] = "```"
        for _, entry in ipairs(unknowns) do
            descLines[#descLines + 1] = stripEmojis(tostring(entry))
        end
        descLines[#descLines + 1] = "```"
    end

    if shouldPing then
        descLines[#descLines + 1] = ">>> RARE DROP DETECTED"
    end

    local embed = {
        title       = "Rewards Update",
        url         = gameLink,
        description = table.concat(descLines, "\n"),
        color       = shouldPing and 15158332 or 5793266,
        thumbnail   = { url = gameIconUrl },
        footer      = { text = "Game ID: " .. PLACE_ID .. " | Universe: " .. UNIVERSE_ID },
        timestamp   = os.date("!%Y-%m-%dT%H:%M:%SZ"),
    }

    local payload = {
        username = "Wesh the diddler",
        embeds   = { embed },
    }

    if shouldPing then
        payload.content = "<@" .. PING_USER_ID .. "> Rare drop detected!"
    end

    local ok, encoded = pcall(HttpService.JSONEncode, HttpService, payload)
    if not ok then return end

    pcall(requestFunction, {
        Url     = webhookUrl,
        Method  = "POST",
        Headers = { ["Content-Type"] = "application/json" },
        Body    = encoded
    })

    task.wait(1)
end

-- =============================================
--   REWARD PARSING
-- =============================================
local player = Players.LocalPlayer

local iconLabels = {
    ["rbxassetid://15296242924"]     = "EXP",
    ["rbxassetid://15147178963"]     = "Gold",
    ["rbxassetid://138197199153705"] = "Canes",
}

local lastSnapshot = ""

local function getRewards(items)
    local gold, xp, canes = "?", "?", "?"
    local unknowns = {}
    local serumCount = 0

    for _, slot in ipairs(items:GetChildren()) do
        if slot:IsA("Frame") then
            local main = slot:FindFirstChild("Main")
            if main then
                local inner = main:FindFirstChild("Inner")
                if inner then
                    local quantityLabel = inner:FindFirstChild("Quantity")
                    local icon          = inner:FindFirstChild("Icon")

                    local quantity = quantityLabel and tostring(quantityLabel.Text) or "?"
                    local iconId   = icon and tostring(icon.Image) or "?"
                    local label    = iconLabels[iconId]

                    if not label then
                        local assetId = iconId:match("rbxassetid://(%d+)") or iconId:match("id=(%d+)") or iconId
                        label = "Unknown"

                        local ok, response = pcall(requestFunction, {
                            Url     = "https://economy.roblox.com/v2/assets/" .. assetId .. "/details",
                            Method  = "GET",
                            Headers = { ["Content-Type"] = "application/json" }
                        })
                        if ok and response and response.StatusCode == 200 then
                            local ok2, data = pcall(HttpService.JSONDecode, HttpService, response.Body)
                            if ok2 and data and data.Name then
                                label = stripEmojis(data.Name)
                                iconLabels[iconId] = label
                            end
                        end
                    end

                    if label == "Gold" then
                        gold = quantity
                    elseif label == "EXP" then
                        xp = quantity
                    elseif label == "Canes" then
                        canes = quantity
                    else
                        unknowns[#unknowns + 1] = stripEmojis(label) .. " | Qty: " .. quantity

                        local lowerLabel = label:lower()
                        if lowerLabel:find("colossal serum") or lowerLabel:find("serum") then
                            local qty = parseRobloxNumber(quantity)
                            serumCount = serumCount + (qty > 0 and qty or 1)
                        end
                    end
                end
            end
        end
    end

    return gold, xp, canes, unknowns, serumCount
end

