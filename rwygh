-- =============================================
--   SCRIPT STATE (controlled via WebSocket)
-- =============================================
local isRunning = true   -- false = stop sending data entirely
local isPaused  = false  -- true  = skip reward processing but keep WS alive

-- =============================================
--   HELPERS
-- =============================================
local function stripEmojis(str)
    return tostring(str):gsub("[^\32-\126]", "")
end

local function setupTeleportQueue()
    if syn and syn.queue_on_teleport then
        syn.queue_on_teleport([[]])
    elseif queue_on_teleport then
        queue_on_teleport([[]])
    end
end

-- =============================================
--   SEND COUNT TO FLASK SERVER
-- =============================================
local function sendToFlask(count)
    if not requestFunction or not isRunning or isPaused then return end

    local ok, encoded = pcall(HttpService.JSONEncode, HttpService, { count = count })
    if not ok then return end

    local success, response = pcall(requestFunction, {
        Url = FLASK_SERVER_URL,
        Method = "POST",
        Headers = { ["Content-Type"] = "application/json" },
        Body = encoded
    })

    if success then
        print("[Serum Counter] Sent count to Flask: +" .. count)
    else
        warn("[Serum Counter] Failed to reach Flask server: " .. tostring(response))
    end
end

local function sendGoldToFlask(amount)
    if not requestFunction or not isRunning or isPaused then return end

    local cleaned = tostring(amount):gsub("[^%d%.]+", "")
    local numAmount = tonumber(cleaned) or 0
    if numAmount <= 0 then return end

    local ok, encoded = pcall(HttpService.JSONEncode, HttpService, { amount = numAmount })
    if not ok then return end

    local success, response = pcall(requestFunction, {
        Url = FLASK_GOLD_URL,
        Method = "POST",
        Headers = { ["Content-Type"] = "application/json" },
        Body = encoded
    })

    if success then
        print("[Gold Tracker] Sent gold to Flask: +" .. numAmount)
    else
        warn("[Gold Tracker] Failed to reach Flask server: " .. tostring(response))
    end
end

-- =============================================
--   COMMAND HANDLER
-- =============================================
local function handleCommand(cmd)
    cmd = tostring(cmd):lower():gsub("%s+", "")

    if cmd == "stop" then
        isRunning = false
        isPaused  = false
        print("[WS] Command received: STOP — halting all sends")

    elseif cmd == "start" then
        isRunning = true
        isPaused  = false
        print("[WS] Command received: START — resuming")

    elseif cmd == "pause" then
        isPaused = true
        print("[WS] Command received: PAUSE — pausing reward sends")

    elseif cmd == "reset_counter" then
        print("[WS] Command received: RESET COUNTER")
        -- Nothing to reset locally; server handles its own totals

    else
        print("[WS] Unknown command: " .. cmd)
    end
end

-- =============================================
--   WEBSOCKET LISTENER (runs in background)
-- =============================================
local wsLib = (syn and syn.websocket) or WebSocket

local function startWebSocket()
    if not wsLib then
        warn("[WS] WebSocket not supported by this executor. Skipping.")
        return
    end

    task.spawn(function()
        while true do
            local ok, ws = pcall(wsLib.connect, WS_URL)
            if ok and ws then
                print("[WS] Connected to Flask server at " .. WS_URL)

                ws.OnMessage:Connect(function(raw)
                    local parseOk, data = pcall(HttpService.JSONDecode, HttpService, raw)
                    if parseOk and data then
                        if data.type == "command" and data.command then
                            handleCommand(data.command)
                        end
                    else
                        -- Try treating it as a plain command string
                        handleCommand(raw)
                    end
                end)

                ws.OnClose:Connect(function()
                    print("[WS] Connection closed. Reconnecting in 5s...")
                end)

                -- Keep this thread alive while WS is open
                -- OnClose fires when it drops, so we just yield here
                while ws do
                    task.wait(1)
                    -- Try sending a heartbeat ping; if it errors the socket dropped
                    local pingOk = pcall(function() ws:Send("ping") end)
                    if not pingOk then break end
                end
            else
                warn("[WS] Could not connect: " .. tostring(ws) .. " — retrying in 5s")
            end

            task.wait(5)
        end
    end)
end

