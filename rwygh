local lastSnapshot = ""

local function getRewards(items)
    local gold, xp, canes = "?", "?", "?"
    local unknowns = {}

    local serumCounts = {
        female   = 0,
        attack   = 0,
        armored  = 0,
        colossal = 0,
        scrolls  = 0,
    }

    for _, slot in ipairs(items:GetChildren()) do
        if slot:IsA("Frame") then
            local main = slot:FindFirstChild("Main")
            if main then
                local inner = main:FindFirstChild("Inner")
                if inner then
                    local quantityLabel = inner:FindFirstChild("Quantity")
                    local icon          = inner:FindFirstChild("Icon")

                    local quantity = quantityLabel and tostring(quantityLabel.Text) or "?"
                    local iconId   = icon and tostring(icon.Image) or "?"
                    local label    = iconLabels[iconId]

                    if not label then
                        local assetId = iconId:match("rbxassetid://(%d+)") or iconId:match("id=(%d+)") or iconId
                        label = "Unknown"

                        local ok, response = pcall(requestFunction, {
                            Url     = "https://economy.roblox.com/v2/assets/" .. assetId .. "/details",
                            Method  = "GET",
                            Headers = { ["Content-Type"] = "application/json" }
                        })
                        if ok and response and response.StatusCode == 200 then
                            local ok2, data = pcall(HttpService.JSONDecode, HttpService, response.Body)
                            if ok2 and data and data.Name then
                                label = stripEmojis(data.Name)
                                iconLabels[iconId] = label
                            end
                        end
                    end

                    if label == "Gold" then
                        gold = quantity
                    elseif label == "EXP" then
                        xp = quantity
                    elseif label == "Canes" then
                        canes = quantity
                    elseif label == "Gems" then
                        sendGemsToFlask(quantity)
                    else
                        unknowns[#unknowns + 1] = stripEmojis(label) .. " | Qty: " .. quantity

                        local lowerLabel = label:lower()
                        local qty = parseRobloxNumber(quantity)
                        if qty <= 0 then qty = 1 end

                        if lowerLabel:find("female serum") then
                            serumCounts.female = serumCounts.female + qty
                        elseif lowerLabel:find("attack serum") then
                            serumCounts.attack = serumCounts.attack + qty
                        elseif lowerLabel:find("armored serum") then
                            serumCounts.armored = serumCounts.armored + qty
                        elseif lowerLabel:find("serum") then
                            serumCounts.colossal = serumCounts.colossal + qty
                        elseif lowerLabel:find("scroll") then
                            serumCounts.scrolls = serumCounts.scrolls + qty
                        end
                    end
                end
            end
        end
    end

    return gold, xp, canes, unknowns, serumCounts
end

