    if prop == "Visible" and rewards.Visible then
        task.wait(0.5)

        local ok, gold, xp, canes, unknowns, serumCount = pcall(getRewards, items)

        if ok then
            sendGoldToFlask(gold)

            if serumCount > 0 then
                sendToFlask(serumCount)
            end

            local snapshot = string.format("Gold:%s|XP:%s|Canes:%s", gold, xp, canes)
            if unknowns and #unknowns > 0 then
                snapshot = snapshot .. "|" .. table.concat(unknowns, "|")
            end

            if snapshot ~= lastSnapshot then
                lastSnapshot = snapshot
                sendWebhook(gold, xp, canes, unknowns)
            end
        end
    end
end)
