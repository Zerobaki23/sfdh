    end
end

local function parseRobloxNumber(str)
    if not str then return 0 end
    local s = tostring(str):gsub("%s+", "")

    local suffixes = { K = 1e3, M = 1e6, B = 1e9, T = 1e12 }
    local num, suffix = s:match("^([%d%.]+)([KkMmBbTt])$")
    if num and suffix then
        local mult = suffixes[suffix:upper()]
        return math.floor((tonumber(num) or 0) * mult)
    end

    local cleaned = s:gsub(",", ""):gsub("[^%d]", "")
    if cleaned == "" then return 0 end
    return tonumber(cleaned) or 0
end

local function getPlayerName()
    local player = Players.LocalPlayer
    if player and player.Name then
        return player.Name
    end
    return "Unknown"
end

local function postToFlask(url, payload, label)
    if not requestFunction then return end
    
    local playerName = getPlayerName()
    payload.player = playerName
    
    local ok, encoded = pcall(HttpService.JSONEncode, HttpService, payload)
    if not ok then return end
    local success, response = pcall(requestFunction, {
        Url     = url,
        Method  = "POST",
        Headers = { ["Content-Type"] = "application/json" },
        Body    = encoded
    })
    if success then
        print("[" .. label .. "] Sent to Flask: " .. HttpService:JSONEncode(payload) .. " | Player: " .. playerName)
    else
        warn("[" .. label .. "] Failed: " .. tostring(response))
    end
end

local function sendGoldToFlask(amount)
    print("[Gold Tracker] Raw UI value: " .. tostring(amount))
    local numAmount = parseRobloxNumber(amount)
    if numAmount <= 0 then
        warn("[Gold Tracker] Skipping non-positive gold value: " .. tostring(amount))
        return
    end
    postToFlask(FLASK_GOLD_URL, { amount = numAmount }, "Gold Tracker")
end

